{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 -m pytest tests/ --cov=agents --cov=integrator --cov-report=term-missing --cov-fail-under=80 -q"
          }
        ]
      }
    ]
  }
}
